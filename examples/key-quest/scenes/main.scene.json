{
  "name": "Key Quest",
  "world": { "width": 960, "height": 540, "gravity": 1800, "background": "#2a1f55" },
  "effects": {
    "jump": { "sound": "hop", "particles": { "count": 6, "color": "#cfd8ff", "speed": 60, "direction": 90, "spread": 150, "life": 0.25, "size": 3, "gravity": 0 } },
    "land": { "sound": "boot", "particles": { "count": 5, "color": "#cfd8ff", "speed": 50, "direction": -90, "spread": 160, "life": 0.2, "size": 2, "gravity": 300 } },
    "boing": { "sound": "boing", "particles": { "count": 12, "color": "#ff7eb6", "speed": 160, "direction": -90, "spread": 70, "life": 0.4, "size": 3 } },
    "key": { "sound": "key-chime", "particles": { "count": 18, "color": "#ffd166", "speed": 150, "life": 0.6, "size": 3, "gravity": 150 } },
    "door-open": { "sound": "door-creak", "shake": 6, "particles": { "count": 26, "color": "#a0714b", "speed": 200, "life": 0.6, "size": 4 } },
    "stomp": { "sound": "squish", "shake": 5, "particles": { "count": 18, "color": "#c77dff", "speed": 180, "life": 0.5, "size": 4 } },
    "die": { "sound": "zap", "shake": 10, "particles": { "count": 30, "color": "#ff5d73", "speed": 220, "life": 0.7, "size": 4 } },
    "win": { "sound": "bell", "shake": 3, "particles": { "count": 60, "color": "#4cc9f0", "speed": 260, "life": 1.2, "size": 4, "gravity": 150 } },
    "timeout": { "sound": "gong", "shake": 8 }
  },
  "entities": [
    { "id": "courtyard", "components": { "transform": { "x": 0, "y": 0 }, "script": { "src": "scripts/courtyard.ts" } } },
    {
      "id": "player",
      "components": {
        "transform": { "x": 80, "y": 482 },
        "body": { "type": "dynamic", "width": 28, "height": 36 },
        "sprite": { "color": "#7cf29c", "image": "assets/player.svg", "frameWidth": 28, "frameHeight": 36, "idle": "0", "run": "1-2", "jump": "3", "fall": "4", "fps": 10, "layer": 3 },
        "platformer": { "speed": 240, "jumpSpeed": 680 }
      }
    },
    {
      "id": "clock",
      "components": {
        "transform": { "x": 0, "y": 0 },
        "script": { "src": "scripts/time-limit.ts", "params": { "seconds": 20 } }
      }
    },
    {
      "id": "ground",
      "components": {
        "transform": { "x": 480, "y": 520 },
        "body": { "type": "static", "width": 960, "height": 40 },
        "sprite": { "color": "#3b4766", "image": "assets/ground.svg", "tile": true }
      }
    },
    { "id": "wall-left", "components": { "transform": { "x": -10, "y": 270 }, "body": { "type": "static", "width": 20, "height": 540 } } },
    { "id": "wall-right", "components": { "transform": { "x": 970, "y": 270 }, "body": { "type": "static", "width": 20, "height": 540 } } },
    {
      "id": "jump-pad",
      "components": {
        "transform": { "x": 255, "y": 493 },
        "body": { "type": "static", "width": 44, "height": 14, "sensor": true },
        "sprite": { "color": "#ff7eb6", "image": "assets/jump-pad.svg", "layer": 1 },
        "script": { "src": "scripts/jump-pad.ts", "params": { "power": 1000 } }
      }
    },
    {
      "id": "ledge",
      "components": {
        "transform": { "x": 380, "y": 300 },
        "body": { "type": "static", "width": 160, "height": 20 },
        "sprite": { "color": "#56658f", "image": "assets/platform.svg", "tile": true }
      }
    },
    {
      "id": "key",
      "components": {
        "transform": { "x": 410, "y": 272 },
        "body": { "type": "static", "width": 24, "height": 24, "sensor": true },
        "sprite": { "color": "#ffd166", "image": "assets/key.svg", "layer": 1 },
        "script": { "src": "scripts/key.ts" }
      }
    },
    {
      "id": "door",
      "components": {
        "transform": { "x": 620, "y": 440 },
        "body": { "type": "static", "width": 28, "height": 120 },
        "sprite": { "color": "#7a4e2d", "image": "assets/door.svg", "layer": 1 },
        "script": { "src": "scripts/locked-door.ts" }
      }
    },
    {
      "id": "chaser",
      "components": {
        "transform": { "x": 820, "y": 487 },
        "body": { "type": "kinematic", "width": 32, "height": 26, "sensor": true },
        "sprite": { "color": "#c77dff", "image": "assets/slime.svg", "frameWidth": 32, "idle": "0", "run": "0-1", "fps": 6, "layer": 2 },
        "hazard": { "stompable": true, "score": 1 },
        "script": { "src": "scripts/chaser.ts", "params": { "speed": 70, "range": 220 } }
      }
    },
    {
      "id": "flag",
      "components": {
        "transform": { "x": 920, "y": 460 },
        "body": { "type": "static", "width": 24, "height": 80, "sensor": true },
        "sprite": { "color": "#4cc9f0", "image": "assets/flag.svg", "frameWidth": 24, "idle": "0-1", "fps": 3, "flip": false, "layer": 1 },
        "emitter": { "rate": 6, "color": "#fff3b0", "speed": 30, "spread": 70, "life": 1.2, "size": 3, "gravity": -20 },
        "goal": { "requireScore": 1 }
      }
    },
    { "id": "hud", "components": { "transform": { "x": 0, "y": 0 }, "script": { "src": "scripts/hud.ts", "params": { "seconds": 20 } } } }
  ],
  "fonts": { "MedievalSharp": "google" },
  "sounds": {
    "hop": { "tones": [{ "wave": "triangle", "from": 280, "to": 560, "duration": 0.11, "volume": 0.16 }], "noise": [{ "filter": "highpass", "from": 4000, "duration": 0.05, "volume": 0.03 }], "vary": 0.07 },
    "boot": { "tones": [{ "wave": "sine", "from": 140, "to": 70, "duration": 0.07, "volume": 0.18 }], "noise": [{ "filter": "bandpass", "from": 2200, "to": 900, "duration": 0.06, "volume": 0.07 }], "vary": 0.15 },
    "boing": { "tones": [{ "wave": "sine", "from": 180, "to": 720, "duration": 0.28, "volume": 0.18 }, { "wave": "triangle", "from": 360, "to": 1440, "start": 0.03, "duration": 0.2, "volume": 0.05 }], "vary": 0.05 },
    "key-chime": {
      "tones": [
        { "wave": "sine", "from": 1568, "duration": 0.5, "volume": 0.1 },
        { "wave": "sine", "from": 2093, "start": 0.08, "duration": 0.6, "volume": 0.08 },
        { "wave": "triangle", "from": 3136, "start": 0.16, "duration": 0.5, "volume": 0.03 }
      ],
      "noise": [{ "filter": "highpass", "from": 7000, "duration": 0.2, "volume": 0.03 }]
    },
    "door-creak": {
      "tones": [{ "wave": "sawtooth", "from": 110, "to": 70, "duration": 0.45, "volume": 0.06, "attack": 0.04 }, { "wave": "sine", "from": 90, "to": 40, "start": 0.35, "duration": 0.35, "volume": 0.22 }],
      "noise": [{ "filter": "bandpass", "from": 1300, "to": 600, "duration": 0.4, "volume": 0.05 }, { "filter": "lowpass", "from": 500, "to": 80, "start": 0.35, "duration": 0.4, "volume": 0.25 }]
    },
    "squish": { "tones": [{ "wave": "sine", "from": 360, "to": 80, "duration": 0.2, "volume": 0.2 }], "noise": [{ "filter": "lowpass", "from": 1500, "to": 200, "duration": 0.2, "volume": 0.14 }], "vary": 0.1 },
    "zap": {
      "tones": [{ "wave": "square", "from": 880, "to": 110, "duration": 0.4, "volume": 0.07 }, { "wave": "sine", "from": 220, "to": 55, "start": 0.1, "duration": 0.45, "volume": 0.18 }],
      "noise": [{ "filter": "bandpass", "from": 3000, "to": 300, "duration": 0.35, "volume": 0.1 }]
    },
    "bell": {
      "tones": [
        { "wave": "sine", "from": 587, "duration": 1.4, "volume": 0.14 },
        { "wave": "sine", "from": 880, "start": 0.02, "duration": 1.2, "volume": 0.08 },
        { "wave": "sine", "from": 1175, "start": 0.25, "duration": 1.2, "volume": 0.1 },
        { "wave": "triangle", "from": 1760, "start": 0.25, "duration": 0.4, "volume": 0.03 }
      ]
    },
    "gong": {
      "tones": [
        { "wave": "sine", "from": 98, "to": 92, "duration": 2, "volume": 0.3 },
        { "wave": "sine", "from": 233, "to": 228, "duration": 1.6, "volume": 0.1 },
        { "wave": "triangle", "from": 415, "duration": 0.8, "volume": 0.04 }
      ],
      "noise": [{ "filter": "bandpass", "from": 600, "to": 200, "duration": 0.6, "volume": 0.08 }]
    }
  },
  "music": {
    "tempo": 132,
    "steps": 2,
    "volume": 0.5,
    "tracks": [
      { "wave": "triangle", "volume": 0.12, "decay": 0.55, "notes": "D5 - F5 E5 | D5 - A4 - | Bb4 - D5 C5 | A4 ~ ~ - | D5 - F5 G5 | A5 - G5 F5 | E5 - C#5 E5 | D5 ~ ~ -" },
      { "wave": "sine", "volume": 0.24, "decay": 0.45, "notes": "D2 D3 D2 D3 | D2 D3 D2 D3 | Bb1 Bb2 Bb1 Bb2 | A1 A2 A1 A2 | D2 D3 D2 D3 | F2 F3 F2 F3 | A1 A2 A1 A2 | D2 D3 A1 A2" },
      {
        "wave": "sawtooth",
        "volume": 0.025,
        "decay": 1,
        "attack": 0.3,
        "filter": 900,
        "notes": "D4+F4+A4 ~ ~ ~ | ~ ~ ~ ~ | Bb3+D4+F4 ~ ~ ~ | A3+C#4+E4 ~ ~ ~ | D4+F4+A4 ~ ~ ~ | F4+A4+C5 ~ ~ ~ | A3+C#4+E4 ~ ~ ~ | D4+F4+A4 ~ ~ ~"
      },
      { "wave": "noise", "filter": 9000, "volume": 0.04, "decay": 0.1, "notes": "x - x - x - x -" },
      { "wave": "noise", "filter": 140, "volume": 0.25, "decay": 0.4, "notes": "X - - - x - x -" }
    ]
  }
}
