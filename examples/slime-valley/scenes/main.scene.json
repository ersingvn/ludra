  "fonts": { "Chewy": "google" },
  "sounds": {
    "hop": {
      "tones": [
        { "wave": "sine", "from": 300, "to": 620, "duration": 0.12, "volume": 0.18 },
        { "wave": "triangle", "from": 600, "to": 1240, "start": 0.02, "duration": 0.08, "volume": 0.05 }
