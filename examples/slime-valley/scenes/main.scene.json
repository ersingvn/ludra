    "chime": {
      "tones": [
        { "wave": "square", "from": 988, "duration": 0.07, "volume": 0.06 },
        { "wave": "square", "from": 1319, "start": 0.07, "duration": 0.22, "volume": 0.06 },
        { "wave": "sine", "from": 2637, "start": 0.07, "duration": 0.3, "volume": 0.04 }
