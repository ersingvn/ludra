{
  "name": "Slime Valley",
  "world": { "width": 1920, "height": 540, "gravity": 1800, "background": "#bfe6ff" },
  "effects": {
    "jump": { "sound": "hop", "particles": { "count": 6, "color": "#8fd19e", "speed": 60, "direction": 90, "spread": 150, "life": 0.25, "size": 3, "gravity": 0 } },
    "land": { "sound": "squelch", "particles": { "count": 5, "color": "#8fd19e", "speed": 50, "direction": -90, "spread": 160, "life": 0.2, "size": 2, "gravity": 300 } },
    "collect": { "sound": "chime", "particles": { "count": 14, "color": "#ffd166", "speed": 140, "life": 0.45, "size": 3, "gravity": 200 } },
    "stomp": { "sound": "splat", "shake": 5, "particles": { "count": 18, "color": "#c77dff", "speed": 180, "life": 0.5, "size": 4 } },
    "die": { "sound": "ouch", "shake": 10, "particles": { "count": 30, "color": "#ff5d73", "speed": 220, "life": 0.7, "size": 4 } },
    "win": { "sound": "fanfare", "shake": 3, "particles": { "count": 60, "color": "#4cc9f0", "speed": 260, "life": 1.2, "size": 4, "gravity": 150 } }
  },
  "entities": [
