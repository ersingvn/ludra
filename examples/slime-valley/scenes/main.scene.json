      "components": {
        "transform": { "x": 0, "y": 0 },
        "script": { "src": "scripts/valley.ts" }
      }
    },
    {
      "id": "player",
      "components": {
        "transform": { "x": 80, "y": 482 },
        "body": { "type": "dynamic", "width": 28, "height": 36 },
        "sprite": {
          "color": "#7cf29c",
          "image": "assets/player.svg",
          "frameWidth": 28,
          "frameHeight": 36,
          "idle": "0",
          "run": "1-2",
          "jump": "3",
          "fall": "4",
