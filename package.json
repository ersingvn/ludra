{
  "name": "ludra-monorepo",
  "private": true,
  "type": "module",
  "description": "Ludra: the game engine built for AI agents.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "node --conditions=ludra-dev --test \"packages/*/test/*.test.ts\"",
    "ludra": "node --conditions=ludra-dev packages/cli/src/index.ts",
    "check:scripts": "tsc -p tsconfig.scripts.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
