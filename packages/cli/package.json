{
  "name": "@ludra/cli",
  "version": "0.92.0",
  "description": "The game engine built for AI agents. The ludra command: create, check, play, test and run Ludra games.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ersingvn/ludra.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ersingvn/ludra#readme",
  "bugs": {
    "url": "https://github.com/ersingvn/ludra/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepack": "tsc -b --clean && tsc -b"
  },
  "type": "module",
  "bin": {
    "ludra": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "ludra-dev": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "blocks"
  ],
  "dependencies": {
    "@ludra/core": "0.92.0",
    "@ludra/physics": "0.92.0",
    "@ludra/three": "0.92.0"
  },
  "keywords": [
    "game-engine",
    "ai",
    "agents",
    "claude",
    "llm",
    "gamedev",
    "headless-testing"
  ],
  "publishConfig": {
    "access": "public"
  }
}
