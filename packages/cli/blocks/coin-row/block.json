{
  "name": "coin-row",
  "description": "Five spinning coins in a row, 40px apart.",
  "tags": [
    "platformer",
    "collectible"
  ],
  "usage": "--at x,y centers the row 40px above (x, y), at head height for a player walking on that surface. Each coin is worth 1 point.",
