{
  "name": "@ludra/physics",
  "version": "0.94.0",
  "description": "Rapier physics for Ludra: rotation, circles and capsules, friction and mass, deterministic across machines.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ersingvn/ludra.git",
    "directory": "packages/physics"
  },
  "homepage": "https://github.com/ersingvn/ludra#readme",
  "bugs": {
    "url": "https://github.com/ersingvn/ludra/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepack": "tsc -b --clean && tsc -b"
  },
  "type": "module",
