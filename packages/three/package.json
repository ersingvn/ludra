{
  "name": "@ludra/three",
  "version": "0.93.0",
  "description": "The 3D renderer for Ludra: Three.js meshes, PBR materials, lights, shadows, cameras and environments for 3D scenes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ersingvn/ludra.git",
    "directory": "packages/three"
  },
  "homepage": "https://github.com/ersingvn/ludra#readme",
  "bugs": {
    "url": "https://github.com/ersingvn/ludra/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepack": "tsc -b --clean && tsc -b"
