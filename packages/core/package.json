{
  "name": "@ludra/core",
  "version": "0.4.0",
  "description": "Ludra engine runtime: scene format, validation, deterministic simulation and rendering.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ersingvn/ludra.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ersingvn/ludra#readme",
  "bugs": {
    "url": "https://github.com/ersingvn/ludra/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepack": "tsc -b --clean && tsc -b"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "ludra-dev": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "ludra-dev": "./src/browser.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "game-engine",
    "ai",
    "agents",
    "llm",
    "gamedev",
    "deterministic",
    "headless-testing"
  ],
  "publishConfig": {
    "access": "public"
  }
}
